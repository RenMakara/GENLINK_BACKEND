                "auth",
                "forgot-password"
              ]
            },
            "description": "Sends a RESET_PASSWORD OTP to a local-password account."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
