                "auth",
                "login"
              ]
            },
            "description": "Expected to fail for a newly registered user until email verification is completed."
          },
          "response": []
        },
        {
          "name": "Current Auth User Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Expected to return 401 because `/api/v1/auth/me` is protected."
          },
          "response": []
        }
      ]
    }
