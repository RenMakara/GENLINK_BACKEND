# GenLink KH production environment
# Database
POSTGRES_DB=CHANGE-ME
POSTGRES_USER=CHANGE-ME
POSTGRES_PASSWORD=CHANGE-ME

# Application
DB_URL=jdbc:postgresql://postgres:{$PORT}/CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

SPRING_PROFILES_ACTIVE=prod

# Generate on the server:  openssl rand -base64 48
JWT_SECRET=CHANGE-ME
JWT_ISSUER=genlink-kh

# Admin portal CORS
ADMIN_CORS_ORIGINS=

# Credential encryption
# Generate on the server:  openssl rand -base64 32
ADMIN_CRYPTO_KEY=CHANGE-ME

# Mail
MAIL_ENABLED=true
MAIL_HOST=MAIL_HOST
MAIL_PORT=PORT
MAIL_USERNAME=CHANGE-ME@gmail.com
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM=CHANGE-ME@gmail.com

# Google Sign-In: use the WEB OAuth client id; Android ids fail validation.
# Separate multiple client ids with commas.
GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
GOOGLE_PROJECT_ID=genlinkkh

# Optional mobile push; enable after Firebase and FCM setup.
NOTIFICATION_MOBILE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=genlinkkh
# Prefer workload identity or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=CHANGE-ME
# Use the Base64 service-account value only in a private .env.
FIREBASE_CREDENTIALS_BASE64=CHANGE-ME

# Behind a reverse proxy
# Trust Nginx X-Forwarded-* headers so HTTPS host changes need no code changes.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Locale
APP_DEFAULT_LANGUAGE=ENGLISH

# S3-compatible object storage
# Set these values to select the storage provider.
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=BUCKET_NAME
STORAGE_CDN_BASE=https://CLOUDFRONT_DOMAIN
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=false
STORAGE_PUBLIC_READ_ACL=false
