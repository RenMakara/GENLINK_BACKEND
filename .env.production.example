# GenLink KH — production environment TEMPLATE.
#
# ⚠️  PLACEHOLDERS ONLY. This file is tracked by git and pushed to GitHub.
#     Never put a real password, secret or app password in here.
#
# On the server, copy it and fill in the real values:
#   cp .env.production.example .env
#   chmod 600 .env                  # owner-only
#   nano .env
#
# `.env` is gitignored, and Docker Compose reads it automatically — so every
# command stays a plain `docker compose up -d`, with no --env-file flag.

# ── PostgreSQL ─────────────────────────────────────────────────────────
# These create the database on first boot of an EMPTY volume. Changing them
# later does NOT rewrite an existing database — see Step 2.
#
# Keep the username simple: letters, digits and underscores. An `@` or `:`
# in a role name has to be percent-encoded inside connection URIs and
# quoted in psql/pg_dump, which makes backups and tooling needlessly
# fragile.
POSTGRES_DB=genlink_db
POSTGRES_USER=genlink_usr
# Generate on the server:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE-ME

# ── Spring Boot datasource (used from Step 3) ──────────────────────────
# Host is `postgres` — the Compose service name, resolved on the internal
# Docker network. NOT localhost: inside a container, localhost is the
# container itself.
DB_URL=jdbc:postgresql://postgres:5432/genlink_db
DB_USERNAME=genlink_usr
# Must match POSTGRES_PASSWORD above.
DB_PASSWORD=CHANGE-ME

# ── Spring profile ─────────────────────────────────────────────────────
# REQUIRED. application.yaml sets `profiles.default: dev`, so omitting this
# silently boots the DEV profile in production — SQL logging on, Swagger
# exposed. Always set it explicitly.
SPRING_PROFILES_ACTIVE=prod

# ── JWT ────────────────────────────────────────────────────────────────
# Must be >= 32 bytes; the app fails fast in prod if unset.
# Generate on the server:  openssl rand -base64 48
JWT_SECRET=CHANGE-ME
JWT_ISSUER=genlink-kh

# ── Admin portal CORS ──────────────────────────────────────────────────
# Origins allowed to call /api/v1/admin/** from a browser. Comma-separated
# full origins, scheme and port included. NO WILDCARD, in any environment.
#
# Leave EMPTY for the MVP: nginx serves the portal and the API on one origin
# (path-based routing), so admin requests are same-origin and CORS never
# applies. Fill this in only when the portal moves to its own subdomain.
#   ADMIN_CORS_ORIGINS=https://admin.genlink.kh
#
# LOCAL DEVELOPMENT is different: the portal runs on :3000 and this API on
# :8888, which really is cross-origin, so set
#   ADMIN_CORS_ORIGINS=http://localhost:3000
# or every admin call answers 403 Invalid CORS request.
ADMIN_CORS_ORIGINS=

# ── Credential encryption ──────────────────────────────────────────────
# Encrypts credential columns at rest - today admin_users.totp_secret.
# Must decode to exactly 32 bytes; the app fails fast in prod if unset.
# Generate on the server:  openssl rand -base64 32
#
# BACK THIS UP alongside JWT_SECRET. Losing it is not recoverable: every
# enrolled administrator has to set up two-factor authentication again,
# and until they do, nobody can sign in to the admin portal.
ADMIN_CRYPTO_KEY=CHANGE-ME

# ── Mail (SMTP) ────────────────────────────────────────────────────────
# Use a transactional SMTP provider and its supported submission port in
# production. Port 2525 is supported by providers such as Brevo, SendGrid and
# Mailgun and avoids common cloud SMTP restrictions. Only these four vars
# change; no code edit is required.
#
#   Brevo (free 300/day). SendGrid and Mailgun also offer 2525.
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=2525
#   MAIL_USERNAME=<provider smtp login>
#   MAIL_PASSWORD=<provider smtp key>
#
# Local development can still use Gmail on 587 (a home ISP does not block
# it): a Google App Password — 16 chars, no spaces, needs 2-Step
# Verification, tied to the exact account in MAIL_USERNAME.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
# The provider's SMTP LOGIN — often a generated credential such as
# 8a1b2c001@smtp-brevo.com, not a mailbox you own.
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
# The visible "From" address. MUST be an address verified with the provider
# (Brevo: Senders, Domains & Dedicated IPs -> Senders -> Add a sender).
# Separate from MAIL_USERNAME because the SMTP login is a credential, not a
# sender. Omit it and the login is used instead, which is right for Gmail.
MAIL_FROM=CHANGE-ME@gmail.com

# ── Google Sign-In ─────────────────────────────────────────────────────
# The WEB OAuth client id — the same value the Flutter app passes as
# serverClientId. An Android client id here fails every token with
# AUTH_INVALID_GOOGLE_TOKEN. Comma-separate to add iOS later.
# Client ids are not secrets, but keep this a placeholder for clarity.
GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
GOOGLE_PROJECT_ID=genlinkkh

# ── Behind a reverse proxy (used from Step 4) ──────────────────────────
# Makes Spring trust the X-Forwarded-* headers Nginx sends, so it knows the
# real scheme and host. This is the single setting that lets you move from
# http://IP to https://api.genlinkkh.com with no code change.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ── Locale ─────────────────────────────────────────────────────────────
APP_DEFAULT_LANGUAGE=ENGLISH

# ── Existing S3-compatible object storage ───────────────────────────────
# The code is provider-neutral, so these values alone decide the provider
# (Spaces / S3 / R2 / MinIO). Keep the current values if media remains where
# it is during the EC2 migration. Region sgp1 = Singapore.
#   Dev:  STORAGE_BUCKET=genlink-media-dev  + its CDN base
#   Prod: STORAGE_BUCKET=genlink + its CDN base
STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com
STORAGE_REGION=sgp1
STORAGE_BUCKET=genlink
STORAGE_CDN_BASE=https://genlink.sgp1.cdn.digitaloceanspaces.com
# The object-storage access key pair. Secrets — never commit real values.
STORAGE_ACCESS_KEY=CHANGE-ME
STORAGE_SECRET_KEY=CHANGE-ME
