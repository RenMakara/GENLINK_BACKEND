# GenLink KH — production environment
#DB
POSTGRES_DB=CHANGE-ME
POSTGRES_USER=CHANGE-ME
POSTGRES_PASSWORD=CHANGE-ME

#APP
DB_URL=jdbc:postgresql://postgres:{$PORT}/CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

SPRING_PROFILES_ACTIVE=prod

# Generate on the server:  openssl rand -base64 48
JWT_SECRET=CHANGE-ME
JWT_ISSUER=genlink-kh

# ── Admin portal CORS ──────────────────────────────────────────────────
ADMIN_CORS_ORIGINS=

# ── Credential encryption ──────────────────────────────────────────────
# Encrypts credential columns at rest - today admin_users.totp_secret.
# Must decode to exactly 32 bytes; the app fails fast in prod if unset.
# Generate on the server:  openssl rand -base64 32
#
# BACK THIS UP alongside JWT_SECRET. Losing it is not recoverable: every
# enrolled administrator has to set up two-factor authentication again,
# and until they do, nobody can sign in to the admin portal.
ADMIN_CRYPTO_KEY=CHANGE-ME

# ── Mail (standard Gmail SMTP) ─────────────────────────────────────────
# OTP delivery uses Spring's standard JavaMail SMTP transport. For Gmail,
# MAIL_PASSWORD must be a Google App Password (16 characters, no spaces),
# not the account password. 2-Step Verification must be enabled first.
# MAIL_FROM may be omitted; it falls back to MAIL_USERNAME.
MAIL_ENABLED=true
MAIL_HOST=MAIL_HOST
MAIL_PORT=PORT
MAIL_USERNAME=CHANGE-ME@gmail.com
MAIL_PASSWORD=CHANGE-ME
MAIL_FROM=CHANGE-ME@gmail.com

# ── Google Sign-In ─────────────────────────────────────────────────────
# The WEB OAuth client id — the same value the Flutter app passes as
# serverClientId. An Android client id here fails every token with
# AUTH_INVALID_GOOGLE_TOKEN. Comma-separate to add iOS later.
# Client ids are not secrets, but keep this a placeholder for clarity.
GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
GOOGLE_PROJECT_ID=genlinkkh

# ── Offline mobile push (optional) ─────────────────────────────────────
# Disabled until the Flutter FCM token flow and Firebase project are ready.
NOTIFICATION_MOBILE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=genlinkkh
# Prefer workload identity or GOOGLE_APPLICATION_CREDENTIALS on the runtime.
# If using a mounted file, this path must be the path inside the app container.
GOOGLE_APPLICATION_CREDENTIALS=
# If the secret manager injects a one-line Base64 service-account JSON instead,
# set it here in the server's private .env (never commit the real value).
FIREBASE_CREDENTIALS_BASE64=

# ── Behind a reverse proxy (used from Step 4) ──────────────────────────
# Makes Spring trust the X-Forwarded-* headers Nginx sends, so it knows the
# real scheme and host. This is the single setting that lets you move from
# http://IP to https://api.genlink.enat.online with no code change.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ── Locale ─────────────────────────────────────────────────────────────
APP_DEFAULT_LANGUAGE=ENGLISH

# ── Existing S3-compatible object storage ───────────────────────────────
# The code is provider-neutral, so these values alone decide the provider
# (Spaces / S3 / R2 / MinIO). Keep the current values if media remains where
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=BUCKET_NAME
STORAGE_CDN_BASE=https://YOUR_CLOUDFRONT_DOMAIN
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=false
STORAGE_PUBLIC_READ_ACL=false
