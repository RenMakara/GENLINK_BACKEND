# Copy this file to .env for local Docker Compose values.
# Do not put real production secrets in this file.

SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=campuslink_db
POSTGRES_USER=campuslink_usr
POSTGRES_PASSWORD=campuslink@168

DB_URL=jdbc:postgresql://localhost:16801/campuslink_db
DB_USERNAME=campuslink_usr
DB_PASSWORD=campuslink@168

JWT_ISSUER=campuslink-kh-dev
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=dev@campuslink.local
MAIL_PASSWORD=replace-with-mail-password

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_PROJECT_ID=genlinkkh-dev
GOOGLE_APPLICATION_CREDENTIALS=./firebase/service-account.json

APP_DEFAULT_LANGUAGE=ENGLISH
