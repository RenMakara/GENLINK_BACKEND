pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(
            name: 'RUN_SONAR',
            defaultValue: true,
            description: 'Run SonarQube analysis and wait for the Quality Gate.'
        )
    }

    environment {
              1 | pipeline {
              2 |     agent any
              3 |
              4 |     options {
              5 |         skipDefaultCheckout(true)
              6 |         timestamps()
              7 |         disableConcurrentBuilds()
              8 |         buildDiscarder(logRotator(numToKeepStr: '20'))
              9 |     }
             10 |
             11 |     parameters {
             12 |         booleanParam(
             13 |             name: 'RUN_SONAR',
             14 |             defaultValue: true,
             15 |             description: 'Run SonarQube analysis and wait for the Quality Gate.'
             16 |         )
             17 |     }
             18 |
             19 |     environment {
             20 |         GRADLE_OPTS = '-Dorg.gradle.daemon=false'
             21 |         SONARQUBE_ENV = 'SonarQube'
             22 |         SONAR_PROJECT_KEY = 'campuslink-kh-backend'
             23 |         SONAR_PROJECT_NAME = 'CampusLink KH Backend'
             24 |     }
             25 |
             26 |     stages {
             27 |         stage('Checkout') {
             28 |             steps {
             29 |                 checkout scm
             30 |             }
             31 |         }
             32 |
             33 |         stage('Prepare Gradle Wrapper') {
             34 |             steps {
             35 |                 script {
             36 |                     if (isUnix()) {
             37 |                         sh 'chmod +x ./gradlew'
             38 |                     }
             39 |                 }
             40 |             }
             41 |         }
             42 |
             43 |         stage('Validate Tools') {
             44 |             steps {
             45 |                 script {
             46 |                     runCommand('java -version', 'java -version')
             47 |                     runCommand('./gradlew --version', '.\\gradlew.bat --version')
             48 |                 }
             49 |             }
             50 |         }
             51 |
             52 |         stage('Test and Coverage') {
             53 |             steps {
             54 |                 script {
             55 |                     runCommand('./gradlew clean test jacocoTestReport', '.\\gradlew.bat clean test jacocoTestReport')
             56 |                 }
             57 |             }
             58 |         }
             59 |
             60 |         stage('SonarQube Analysis') {
             61 |             when {
             62 |                 expression { return params.RUN_SONAR }
             63 |             }
             64 |             steps {
             65 |                 withSonarQubeEnv("${env.SONARQUBE_ENV}") {
             66 |                     script {
             67 |                         runCommand(
             68 |                             "./gradlew sonar -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} -Dsonar.projectName='${env.SONAR_PROJECT_NAME}' -Dsonar.host.url=${env.SONAR_HOST_URL} -Dsonar.token=${env.SONAR_AUTH_TOKEN}",
             69 |                             ".\\gradlew.bat sonar -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} \"-Dsonar.projectName=${env.SONAR_PROJECT_NAME}\" -Dsonar.host.url=${env.SONAR_HOST_URL} -Dsonar.token=${env.SONAR_AUTH_TOKEN}"
             70 |                         )
             71 |                     }
             72 |                 }
             73 |             }
             74 |         }
             75 |
             76 |         stage('Quality Gate') {
             77 |             when {
             78 |                 expression { return params.RUN_SONAR }
             79 |             }
             80 |             steps {
             81 |                 timeout(time: 5, unit: 'MINUTES') {
             82 |                     waitForQualityGate abortPipeline: true
             83 |                 }
             84 |             }
             85 |         }
             86 |
             87 |         stage('Build Jar') {
             88 |             steps {
             89 |                 script {
             90 |                     runCommand('./gradlew bootJar -x test', '.\\gradlew.bat bootJar -x test')
             91 |                 }
             92 |             }
             93 |         }
             94 |     }
             95 |
             96 |     post {
             97 |         always {
             98 |             junit allowEmptyResults: true, testResults: 'build/test-results/test/*.xml'
             99 |             archiveArtifacts allowEmptyArchive: true, artifacts: 'build/libs/*.jar, build/reports/jacoco/test/html/**, build/reports/jacoco/test/jacocoTestReport.xml'
            100 |         }
            101 |     }
            102 | }
            103 |
            104 | void runCommand(String unixCommand, String windowsCommand) {
            105 |     if (isUnix()) {
            106 |         sh unixCommand
            107 |     } else {
            108 |         bat windowsCommand
            109 |     }
            110 | }
            111 |
